{
  "name": "agents-everywhere-starter-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Starter kit for the Agents, Everywhere: Bots, Channels & More global hackathon.",
  "license": "MIT",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "workspaces": [
    "packages/*",
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:web": "npm run dev --workspace web",
    "test": "npm run test --workspaces --if-present",
    "verify": "npm run typecheck && npm test"
  },
  "overrides": {
    "@ag-ui/client": "1.0.2",
    "@azure/msal-node": "7.1.0",
    "@fastify/busboy": "3.2.2",
    "@graphql-tools/utils": "12.0.2",
    "katex": "0.18.2",
    "postcss": "8.5.23",
    "undici": "6.29.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0"
  }
}
